<mujoco model="scene_football">
    <!-- Football pitch for the microduck: duck + ball + goal, walled so the ball stays in play.
         Pitch: x in [-0.9, 1.7], y in [-1.0, 1.0].  Goal mouth is in the +x end wall,
         |y| < 0.25, with a net box behind it.  Goal detection lives in duck_sim.py
         (ball centre past x = 1.7 + ball radius, inside the mouth).
         Walls, posts and nets are solid for both the ball and the duck. -->
    <include file="robot_groundcontact.xml" />
    <include file="ball.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="90" elevation="-55" offwidth="640" offheight="480" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="grass" builtin="checker" mark="none" rgb1="0.18 0.45 0.2"
            rgb2="0.15 0.40 0.17" width="300" height="300" />
        <material name="grass" texture="grass" texuniform="true" texrepeat="16 16" reflectance="0" />
        <material name="wall" rgba="0.9 0.9 0.9 1" />
        <material name="post" rgba="1 1 1 1" />
        <material name="net" rgba="0.85 0.2 0.85 1" />
        <material name="line" rgba="1 1 1 1" />
    </asset>

    <worldbody>
        <light pos="0.4 0 4" dir="0 0 -1" directional="true" castshadow="false" />
        <geom name="floor" size="5 5 0.05" pos="0.4 0 0" type="plane" material="grass" />

        <!-- pitch lines (visual only): halfway line and centre circle -->
        <geom type="box" pos="0.4 0 0.0005" size="0.004 1.0 0.0005" material="line" contype="0" conaffinity="0"/>
        <geom type="cylinder" pos="0.4 0 0.0005" size="0.25 0.0005" rgba="1 1 1 0.35" contype="0" conaffinity="0"/>

        <!-- side walls (10 cm: a 7 cm ball cannot roll over) -->
        <geom name="wall_left"  type="box" pos="0.4  1.005 0.05" size="1.305 0.005 0.05" material="wall"/>
        <geom name="wall_right" type="box" pos="0.4 -1.005 0.05" size="1.305 0.005 0.05" material="wall"/>
        <!-- own end wall -->
        <geom name="wall_back"  type="box" pos="-0.905 0 0.05" size="0.005 1.0 0.05" material="wall"/>
        <!-- goal end wall: two segments with a 0.5 m mouth -->
        <geom name="wall_goal_l" type="box" pos="1.705  0.625 0.05" size="0.005 0.375 0.05" material="wall"/>
        <geom name="wall_goal_r" type="box" pos="1.705 -0.625 0.05" size="0.005 0.375 0.05" material="wall"/>
        <!-- posts, bar, net: 30 cm high, taller than the 25 cm duck so it can follow the ball in -->
        <geom name="post_l" type="cylinder" fromto="1.7  0.25 0 1.7  0.25 0.3" size="0.01" material="post"/>
        <geom name="post_r" type="cylinder" fromto="1.7 -0.25 0 1.7 -0.25 0.3" size="0.01" material="post"/>
        <geom name="crossbar" type="cylinder" fromto="1.7 -0.25 0.3 1.7 0.25 0.3" size="0.01" material="post"/>
        <geom name="net_back"  type="box" pos="1.85 0 0.15"  size="0.005 0.25 0.15" material="net"/>
        <geom name="net_left"  type="box" pos="1.775  0.25 0.15" size="0.075 0.005 0.15" material="net"/>
        <geom name="net_right" type="box" pos="1.775 -0.25 0.15" size="0.075 0.005 0.15" material="net"/>
        <geom name="net_top"   type="box" pos="1.775 0 0.3"  size="0.075 0.25 0.005" material="net"/>
        <!-- Opponents, each a MOCAP body moved through data.mocap_pos (duck_sim.ObstacleManager):
             moving geoms of the static world body does NOT work (the collision midphase keeps the
             world body's compile-time bounding volume: moved geoms are drawn but never collide).
             def_*: defenders, 18 cm wide cylinders.  keeper: 16 cm wide box in front of the goal.
             All parked off the pitch when unused. -->
        <body name="def_0" mocap="true" pos="-3.0 -2.0 0.1">
            <geom name="def_0" type="cylinder" size="0.09 0.1" rgba="0.85 0.15 0.15 1"/>
        </body>
        <body name="def_1" mocap="true" pos="-3.0 -2.5 0.1">
            <geom name="def_1" type="cylinder" size="0.09 0.1" rgba="0.85 0.15 0.15 1"/>
        </body>
        <body name="def_2" mocap="true" pos="-3.0 -3.0 0.1">
            <geom name="def_2" type="cylinder" size="0.09 0.1" rgba="0.85 0.15 0.15 1"/>
        </body>
        <body name="keeper" mocap="true" pos="-3.0 -3.5 0.1">
            <geom name="keeper" type="box" size="0.03 0.08 0.1" rgba="0.1 0.3 0.9 1"/>
        </body>
    </worldbody>
</mujoco>
